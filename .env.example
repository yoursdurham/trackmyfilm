# Server-only. Secret iCal address for the studio Google Calendar
# (hello@yoursdurham.com). Set this in Vercel for Production and Preview.
# Do not prefix it with NEXT_PUBLIC_, do not log it, and do not commit a real value.
STUDIO_CALENDAR_ICS_URL=https://calendar.google.com/calendar/ical/example/basic.ics

# Comma-separated staff login emails. Server-only — do not use NEXT_PUBLIC_.
# When set, only these accounts can open staff pages and call staff APIs.
# When missing or blank, any signed-in user is still allowed and a warning is logged.
# STAFF_EMAILS=owner@yoursdurham.com,staff@yoursdurham.com

# Comma-separated emails that can open /numbers. Server-only.
# If unset, NEXT_PUBLIC_ADMIN_EMAILS is still read.
# Supabase app_metadata.role = admin is also accepted. user_metadata is not.
# ADMIN_EMAILS=owner@yoursdurham.com
